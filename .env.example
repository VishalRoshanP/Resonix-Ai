# RESONIX AI — Global Root Environment Configuration

# Express Backend Server (Port 5000)
PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/resonix_ai
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Google AI Studio / Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Citizen Web Client (Port 5173)
VITE_BACKEND_URL=http://localhost:5000
VITE_APP_MODE=citizen
VITE_ENABLE_OFFLINE_MESH=true

# Responder Dashboard Web Client (Port 5174)
VITE_BACKEND_URL=http://localhost:5000
VITE_APP_MODE=responder
VITE_ENABLE_MOCK_FALLBACK=false
