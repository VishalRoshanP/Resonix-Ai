# RESONIX AI — Global Root Environment Configuration

# Express Backend Server (Port 5000)
PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/resonix_ai
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Local Ollama / HuggingFace AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
HF_TOKEN=your_huggingface_token_here
HF_MODEL=google/gemma-4-e4b-it

# Citizen Mobile / Web Client (Port 5173)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_MODE=citizen
VITE_ENABLE_OFFLINE_MESH=true

# Responder Dashboard Web Client (Port 5174)
VITE_RESPONDER_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_MODE_RESPONDER=responder
