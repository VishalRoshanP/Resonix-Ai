# RESONIX AI Environment Configuration
PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/resonix_ai
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Centralized Model Registry (Powered by GEMINI_API_KEY)
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TRANSLATE_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMMA_VERIFICATION_MODEL=gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Sarvam AI Speech Intelligence Configuration (Server-Side ONLY)
SARVAM_API_KEY=your_sarvam_api_key_here
NODE_ENV=development

# Initial Administrator Bootstrap Credentials (Required for bootstrapAdmin.js)
ADMIN_EMAIL=admin@your-agency.gov
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_BADGE_ID=RESONIX-ADM-001
