# For physical Android device testing over Wi-Fi, replace localhost with your host PC IP (e.g. http://192.168.1.10:5000/api/v1)
# For Android Emulator, http://10.0.2.2:5000/api/v1 is resolved automatically if not specified.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_MODE=citizen
VITE_ENABLE_OFFLINE_MESH=true
